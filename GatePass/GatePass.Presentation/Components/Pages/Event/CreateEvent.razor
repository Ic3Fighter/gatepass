@page "/event/{id:guid?}"
@rendermode InteractiveServer


<h3>CreateEvent</h3>
<p>Id is @Id</p>

@if (_loaded && _event is not null)
{
    <EditForm Model="_event" FormName="CreateEditEvent" OnValidSubmit="ProcessSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div>
            <label>
                Title:
                <InputText @bind-Value="_event.Title" />
            </label>
        </div>
        <div>
            <label>
                Description
                <InputTextArea @bind-Value="_event.Description" />
            </label>
        </div>
        <div>
            <label>
                Organizer
                <InputText @bind-Value="_event.Organizer" />
            </label>
        </div>
        <div>
            <label>
                LocationName
                <InputText @bind-Value="_event.LocationName" />
            </label>
        </div>
        <div>
            <label>
                Startdate
                <InputDate @bind-Value="_event.Start" />
            </label>
        </div>
        <div>
            <label>
                Enddate
                <InputDate @bind-Value="_event.End" />
            </label>
        </div>
        <button type="submit">Submit</button>
    </EditForm>
}
else if (_loaded && _event is null)
{
    <p>not found</p>
}
else
{
    <p><em>Loading...</em></p>
}
