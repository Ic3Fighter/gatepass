@page "/event/{id:guid?}"
@rendermode InteractiveServer

@using GatePass.Business.BusinessProviders
@using GatePass.Business.BusinessProviders.Entities
@inject EventBusinessProvider _eventBusinessProvider

<h3>CreateEvent</h3>
<p>Id is @Id</p>

@if (_loaded == true && _event is not null)
{
    <EditForm Model="_event" FormName="CreateEditEvent" OnValidSubmit="ProcessSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <label>
            Title:
            <InputText @bind-Value="_event.Title" />
        </label>

        <label>
            Description
            <InputTextArea @bind-Value="_event.Description" />
        </label>

        <label>
            LocationName
            <InputText @bind-Value="_event.LocationName" />
        </label>

        <label>
            Startdate
            <InputDate @bind-Value="_event.Start" />
        </label>

        <label>
            Enddate
            <InputDate @bind-Value="_event.End" />
        </label>
        <button type="submit">Submit</button>
    </EditForm>
}
else if (_loaded == true && _event is null)
{
    <p>not found</p>
}
else
{
    <p><em>Loading...</em></p>
}
